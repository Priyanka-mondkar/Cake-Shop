# ============================================
# FRONTEND ONLY - .gitignore
# For HTML, CSS, JavaScript projects
# ============================================

# ------------------ Node.js / npm ----------
# Dependency directories (if using npm/yarn/pnpm)
node_modules/
jspm_packages/

# Package lock files (optional - team preference)
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# ------------------ Build outputs ----------
# Bundlers (Webpack, Vite, Parcel, Rollup, etc.)
dist/
build/
out/
output/
.well-known/

# Compiled files
*.min.js
*.min.css
*.bundle.js
*.chunk.js
*.chunk.css

# TypeScript compiled output
*.js.map
*.d.ts.map
*.d.ts
tsconfig.tsbuildinfo

# ------------------ CSS preprocessors ------
# Sass/SCSS cache
.sass-cache/
*.css.map
*.scssc

# Less cache
.less-cache/

# Stylus dependencies
.stylus.deps

# ------------------ IDE / Editor files -----
# Visual Studio Code
.vscode/
.history/
*.code-workspace
.vscode-test/

# WebStorm / JetBrains
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# Sublime Text
*.sublime-project
*.sublime-workspace
.sublime/

# Atom
.atom/
*.atom

# Vim
*.swp
*.swo
*~
.~*
.*.swp

# Emacs
*~
\#*\#
.\#*

# ------------------ OS generated files -----
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.tmp
desktop.ini
$RECYCLE.BIN/
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# Linux
.directory
*.~lock.*
.dmrc
*.swp

# ------------------ Logs & temp files -----
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

*.tmp
*.temp
*.cache
.cache/
.parcel-cache/
.vite/

# ------------------ Environment files -----
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test

# ------------------ Testing ----------------
coverage/
.nyc_output/
.jest/
__tests__/__snapshots__/
*.test.js
*.spec.js
*.test.ts
*.spec.ts
.screenshots/
test-results/

# ------------------ Linting & formatting ----
.eslintcache
.prettiercache
.stylelintcache
*.ln

# ------------------ Frontend frameworks ----
# React
.next/
.out/
.build/
.nuxt/
.nuxt-dist/
.svelte-kit/

# Angular
dist/
tmp/
out-tsc/

# Vue
.vercel/
.cache/

# ------------------ Assets (optional) ------
# Uncompressed images (if you keep originals separately)
*.psd
*.sketch
*.fig
*.xd
*.ai
*.indd

# Video/audio source files
*.mp4
*.mov
*.avi
*.flac
*.wav

# ------------------ Documentation ----------
docs/_build/
_site/
.gh-pages/
*.pdf
*.docx

# ------------------ Misc -------------------
*.7z
*.rar
*.zip
*.tar.gz
*.bak
*.old
*.orig
*.rej
.DS_Store
*.swp
.ftpconfig
.ftppasswd
.netlify
.hugo_build.lock
.vscode-test/

# ------------------ Keep important! ----------
# Never ignore these critical frontend files
# !index.html
# !style.css
# !main.js
# !.gitignore